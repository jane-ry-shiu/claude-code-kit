{
  "PreToolUse": [
    {
      "matcher": "Bash",
      "hooks": [
        { "type": "command", "command": "~/.claude/hooks/intercept-pr-comment.sh" }
      ]
    }
  ],
  "Stop": [
    {
      "hooks": [
        { "type": "command", "command": "~/.claude/hooks/review-done-notify.py", "timeout": 30, "async": true }
      ]
    }
  ]
}
