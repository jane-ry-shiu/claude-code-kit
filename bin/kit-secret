#!/usr/bin/env bash
# Credential store for claude-code-kit.
#
# Secrets live in the macOS Keychain (service "claude-code-kit"), never in a
# file under this repo or in Claude Code's JSON config. An environment
# variable of the same name always wins, so CI or a non-macOS machine can
# supply values without a Keychain.
#
# Usage:
#   kit-secret set NAME          prompt for a value and store it (input hidden)
#   kit-secret get NAME          print the value (env first, then Keychain)
#   kit-secret list              show which known names are set (never values)
#   kit-secret env               print `export NAME=...` lines for every stored
#                                name; meant for: eval "$(kit-secret env)"
#   kit-secret delete NAME       remove a stored value

set -euo pipefail

SERVICE="claude-code-kit"

# Every name the kit's MCP servers and skill scripts read.
KNOWN_NAMES=(
  JIRA_USERNAME
  JIRA_API_TOKEN
  CONFLUENCE_USERNAME
  CONFLUENCE_API_TOKEN
  REDMINE_API_KEY
  APIDOG_ACCESS_TOKEN
  GITHUB_PAT
)

has_keychain() { command -v security >/dev/null 2>&1; }

keychain_get() {
  has_keychain || return 1
  security find-generic-password -s "$SERVICE" -a "$1" -w 2>/dev/null
}

lookup() {
  local name="$1"
  if [[ -n "${!name:-}" ]]; then
    printf '%s' "${!name}"
    return 0
  fi
  keychain_get "$name"
}

require_name() {
  [[ -n "${1:-}" ]] || { echo "kit-secret: missing NAME" >&2; exit 64; }
  [[ "$1" =~ ^[A-Z][A-Z0-9_]*$ ]] || { echo "kit-secret: NAME must be UPPER_SNAKE_CASE" >&2; exit 64; }
}

cmd="${1:-}"; shift || true
case "$cmd" in
  set)
    require_name "${1:-}"
    has_keychain || { echo "kit-secret: no macOS Keychain here; export $1 in your shell instead" >&2; exit 69; }
    read -r -s -p "Value for $1: " value; echo >&2
    [[ -n "$value" ]] || { echo "kit-secret: empty value, nothing stored" >&2; exit 65; }
    # -U updates an existing item; -T lets /usr/bin/security read it back without a prompt.
    security add-generic-password -U -s "$SERVICE" -a "$1" -T /usr/bin/security -w "$value"
    echo "stored $1" >&2
    ;;
  get)
    require_name "${1:-}"
    lookup "$1" || { echo "kit-secret: $1 is not set (run: kit-secret set $1)" >&2; exit 1; }
    ;;
  list)
    for name in "${KNOWN_NAMES[@]}"; do
      if [[ -n "${!name:-}" ]]; then src="env"
      elif keychain_get "$name" >/dev/null; then src="keychain"
      else src="-"; fi
      printf '%-22s %s\n' "$name" "$src"
    done
    ;;
  env)
    for name in "${KNOWN_NAMES[@]}"; do
      if value="$(lookup "$name")" && [[ -n "$value" ]]; then
        printf 'export %s=%q\n' "$name" "$value"
      fi
    done
    ;;
  delete)
    require_name "${1:-}"
    security delete-generic-password -s "$SERVICE" -a "$1" >/dev/null && echo "deleted $1" >&2
    ;;
  *)
    sed -n '2,17p' "$0" | sed 's/^# \{0,1\}//'
    exit 64
    ;;
esac
